# Copy to .env for local development. On Vercel, add these under Project → Settings → Environment Variables.

# Required for answers: Google AI Studio key (https://aistudio.google.com/apikey). Gemini writes the answers,
# reranks the threads, tags board questions and suggests follow-ups. Free tier: gemini-2.5-flash 250 requests/day,
# flash-lite 1,000/day.
GEMINI_API_KEY=

# Embeddings (semantic search). One provider is enough; the first one with a key is used, or set ROR_EMBED_PROVIDER.
# Voyage AI (recommended): 200M free tokens per account, no card needed. https://dashboard.voyageai.com
VOYAGE_API_KEY=
# Cloudflare Workers AI (alternative): 10,000 free neurons a day (about 9M tokens with bge-m3), resets daily.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# ROR_EMBED_PROVIDER=voyage        # voyage | cloudflare | gemini

# The student board and the announcements feed live in Supabase (Postgres). Run supabase/schema.sql once in the
# project's SQL editor, then set these two. Without them the board runs in memory locally and is switched off in
# production. Project → Settings → API: the URL and the service_role key (server only, never in the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ROR_BOARD_STORE=memory           # force the in-memory board (tests, demos)

# Where listings, rides and lost-and-found requests are sent. Falcon trades go to this site's own Falcons page.
# ROR_GROUP_URL=https://www.facebook.com/groups/nyuad.room.of.requirement

# Optional model overrides (defaults shown).
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_CHAT_FALLBACK_MODELS=gemini-2.5-flash-lite   # tried in order when the chat model is out of quota
# GEMINI_LITE_MODEL=gemini-2.5-flash-lite
# VOYAGE_EMBED_MODEL=voyage-3.5
# VOYAGE_EMBED_DIMENSIONS=1024
# CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-m3
# CLOUDFLARE_EMBED_DIMENSIONS=1024
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_EMBED_DIMENSIONS=768

# Optional: embed during `npm run build` when no data/index exists (slow for big archives; prefer `npm run index` locally).
# ROR_EMBED_ON_BUILD=1

# Optional: where the scraper writes and the indexer reads (defaults to data/posts.jsonl and data/index).
# ROR_POSTS_FILE=data/posts.jsonl
# ROR_INDEX_DIR=data/index

# Scraper: where to keep the logged-in browser profile (the group comes from ROR_GROUP_URL above).
# ROR_BROWSER_PROFILE=.scraper-profile

# The weekly roundup (api/digest.ts, Mondays 06:00 UTC via vercel.json crons). CRON_SECRET must match what Vercel sends;
# without RESEND_API_KEY the route only composes the mails (dry run). DIGEST_FROM needs a domain verified on Resend.
# CRON_SECRET=
# RESEND_API_KEY=
# DIGEST_FROM=nyuad.life <roundup@nyuad.life>
# ROR_SITE_URL=https://nyuad.life

# Official NYUAD pages (npm run scrape:official, then npm run index:official; the GitHub workflow does both weekly).
# ROR_OFFICIAL_FILE=data/official.jsonl
# ROR_OFFICIAL_INDEX_DIR=data/official-index
